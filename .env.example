# チェーンにつなぐときの設定。何も書かなければ、チェーンなし（端末内だけ）で動きます。
# ローカルの devnet は `npm run devnet` が .env.devnet.local に、
# Sepolia は `npm run deploy:sepolia` が .env.sepolia.local に自動で書きます。

# devnet | sepolia
VITE_CHAIN=
VITE_RPC_URL=
VITE_CONTRACT_ADDRESS=
# イベントを読み始めるブロック（デプロイしたブロック）
VITE_DEPLOY_BLOCK=0

# devnet 専用。devnet の決まった seed から作られるテスト用アカウント（実資産なし）
VITE_DEV_ACCOUNT_ADDRESS=
VITE_DEV_ACCOUNT_KEY=
